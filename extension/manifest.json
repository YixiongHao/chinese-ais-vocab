{
  "manifest_version": 3,
  "name": "AI Safety Terminology — English ⇄ 中文",
  "version": "0.1.0",
  "description": "Highlights AI safety terms as you browse and shows the translation, who uses it, how certain it is, and a real example sentence.",
  "homepage_url": "https://github.com/YixiongHao/chinese-ais-vocab",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "activeTab"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Safety Terminology",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["data/index.js", "src/matcher.js", "src/content.js"],
      "css": ["src/highlight.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
