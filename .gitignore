# Build output. Everything here is regenerated by scripts/ and nothing depends on it
# being in the repo — the packaged extension zip is rebuilt by package-extension.mjs.
dist/

# Dependencies. Nothing in this project has any, but a stray npm install shouldn't
# land 40 MB in a commit.
node_modules/
package-lock.json

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp
*~

# Logs and scratch. Research and audit runs are noisy; keep their output out of the
# repo unless it's a data file someone deliberately checked in under data/.
*.log
npm-debug.log*
scratch/
tmp/

# Local agent settings — machine-specific, not shared.
.claude/settings.local.json

# Committed on purpose, listed here so nobody "cleans them up":
#   data/terms.json, site/terms-data.js, exports/terms.csv, extension/data/*
#     build output, but the site and the unpacked extension load them directly
#   data/audit-*.json
#     audit output, kept as the record of what the last pass found
